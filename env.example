# Copy to .env and fill in. Without these, the app runs in offline demo mode
# (constraint engine + scheduler work fully; AI text uses a built-in fallback).
AI_PROVIDER=auto
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
PORT=5000
MODEL_FILE=data/model.joblib
